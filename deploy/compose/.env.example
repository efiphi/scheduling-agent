# Copy to deploy/compose/.env and replace every value. .env is git-ignored (T17).
# Generate a value with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Database roles, one per service (deploy/compose/postgres/init/01-roles.sh).
OWNER_DB_PASSWORD=change-me
API_DB_PASSWORD=change-me
GATEWAY_DB_PASSWORD=change-me
# google-gateway only. Generate with:
#   uv run --package google-gateway python -m google_gateway.keys
TOKEN_ENCRYPTION_KEYS=change-me
# google-gateway's OAuth client "gateway-connect" (Google Cloud console > Clients).
# Redirect URI registered there: http://localhost:8001/oauth/google/callback
GOOGLE_CONNECT_CLIENT_ID=change-me
GOOGLE_CONNECT_CLIENT_SECRET=change-me
# agent only (ADR-015). Create in the Anthropic Console with a monthly spend limit.
ANTHROPIC_API_KEY=change-me
# Daily spend cap in code (T24); the agent stops taking tasks above it until the next day.
AGENT_DAILY_BUDGET_USD=1.00
# api only: the login OAuth client "api-login" (identity scopes only, ADR-010).
# Redirect URI registered there: http://localhost:8000/auth/google/callback
GOOGLE_LOGIN_CLIENT_ID=change-me
GOOGLE_LOGIN_CLIENT_SECRET=change-me
# api only: WhatsApp Cloud API (ADR-017). A System User token with only
# whatsapp_business_messaging + whatsapp_business_management, never expiring.
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
# Verifies the webhook's X-Hub-Signature-256 (App settings > Basic > App secret).
WHATSAPP_APP_SECRET=change-me
# Any random string; paste the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=change-me
# The approved utility template for notifications outside WhatsApp's 24-hour window
# (ADR-017). Empty: no notification outside the window; the web app still shows actions.
WHATSAPP_NOTIFY_TEMPLATE=
# Grafana on the cluster (user admin). Sealed into deploy/cluster/observability/manifests/.
GRAFANA_ADMIN_PASSWORD=
