# Copy to deploy/compose/.env and replace every value. .env is git-ignored (T17).
# Generate a value with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Database roles, one per service (deploy/compose/postgres/init/01-roles.sh).
OWNER_DB_PASSWORD=change-me
API_DB_PASSWORD=change-me
GATEWAY_DB_PASSWORD=change-me
