#!/bin/bash
# Runs once on every new server, after a spot interruption too (ADR-023):
#   1. take over the fixed public address;
#   2. attach the data volume, which holds k3s's whole state, and mount it;
#   3. install k3s at a pinned version, checked against its published SHA-256 (T20);
#   4. start it under the same node name, so it is the same cluster as before.
set -euo pipefail
exec > >(tee -a /var/log/scheduling-agent-boot.log) 2>&1

REGION="${region}"
VOLUME_ID="${volume_id}"

token=$(curl -sf -X PUT http://169.254.169.254/latest/api/token \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
instance_id=$(curl -sf -H "X-aws-ec2-metadata-token: $token" \
  http://169.254.169.254/latest/meta-data/instance-id)

# 1. The address. --allow-reassociation takes it from a server that is going away.
aws ec2 associate-address --region "$REGION" --allocation-id "${eip_allocation}" \
  --instance-id "$instance_id" --allow-reassociation

# 2. The data volume. After an interruption the old server may still be releasing it.
for _ in $(seq 120); do
  state=$(aws ec2 describe-volumes --region "$REGION" --volume-ids "$VOLUME_ID" \
    --query 'Volumes[0].State' --output text)
  [ "$state" = available ] && break
  sleep 5
done
aws ec2 attach-volume --region "$REGION" --volume-id "$VOLUME_ID" \
  --instance-id "$instance_id" --device /dev/sdf

# Nitro instances name EBS volumes nvme*; the volume id, without its dash, is the serial.
serial=$(echo "$VOLUME_ID" | tr -d '-')
by_id="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$serial"
for _ in $(seq 60); do [ -e "$by_id" ] && break; sleep 2; done
device=$(readlink -f "$by_id")
blkid "$device" || mkfs.ext4 -L sa-data "$device" # formatted on the very first boot only
mkdir -p /var/lib/rancher
mount "$device" /var/lib/rancher
echo "LABEL=sa-data /var/lib/rancher ext4 defaults,nofail 0 2" >> /etc/fstab

# A little swap, so a memory spike slows the server down instead of killing a pod. Used
# only when memory is nearly gone (swappiness 10), and never for k3s itself (MemorySwapMax
# below): a swapped-out API server made the whole cluster stall on the first deploy.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
  chmod 600 /swapfile
  mkswap /swapfile
fi
swapon /swapfile
grep -q "^/swapfile" /etc/fstab || echo "/swapfile none swap defaults 0 0" >> /etc/fstab # after a reboot too
echo "vm.swappiness = 10" > /etc/sysctl.d/90-scheduling-agent.conf
sysctl -q --system

# 3. k3s, pinned and verified. No install script piped into a shell.
curl -fsSL -o /usr/local/bin/k3s \
  "https://github.com/k3s-io/k3s/releases/download/${replace(k3s_version, "+", "%2B")}/k3s-arm64"
echo "${k3s_sha256}  /usr/local/bin/k3s" | sha256sum -c -
chmod 0755 /usr/local/bin/k3s
for tool in kubectl crictl ctr; do ln -sf /usr/local/bin/k3s "/usr/local/bin/$tool"; done

# 4. The same node name every time, so a new instance continues the same cluster.
cat > /etc/systemd/system/k3s.service <<'UNIT'
[Unit]
Description=k3s (scheduling-agent)
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/k3s server \
  --node-name sa-cloud \
  --write-kubeconfig-mode 0600 \
  --secrets-encryption
KillMode=process
Delegate=yes
MemorySwapMax=0
LimitNOFILE=1048576
LimitNPROC=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now k3s

# 5. A nightly database backup to S3 (backup.tf). On the host, because only the host has
#    the instance role: pods cannot reach it (IMDSv2, hop limit 1).
cat > /usr/local/bin/sa-backup <<'SCRIPT'
#!/bin/bash
# pg_dump of the database, uploaded to the backup bucket, which this server may write to and
# nothing more. The temporary copy is on the data volume, root only, and removed after.
set -euo pipefail
dir=/var/lib/rancher/sa-backup
mkdir -p -m 0700 "$dir"
file="$dir/scheduling_agent-$(date -u +%Y-%m-%dT%H%M%SZ).dump"
trap 'rm -f "$file"' EXIT
/usr/local/bin/k3s kubectl -n scheduling-agent exec postgres-0 -- \
  pg_dump -U postgres --format=custom scheduling_agent > "$file"
# The custom format starts with "PGDMP"; anything else is an error, not a backup.
[ "$(head -c 5 "$file")" = PGDMP ] || { echo "not a pg_dump file" >&2; exit 1; }
aws s3 cp "$file" "s3://${backup_bucket}/postgres/$(basename "$file")" \
  --region "${region}" --sse AES256 --only-show-errors
echo "uploaded $(basename "$file") ($(stat -c %s "$file") bytes)"
SCRIPT
chmod 0700 /usr/local/bin/sa-backup
cat > /etc/systemd/system/sa-backup.service <<'UNIT'
[Unit]
Description=Back up the scheduling-agent database to S3
After=k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sa-backup
UNIT
cat > /etc/systemd/system/sa-backup.timer <<'UNIT'
[Unit]
Description=Nightly scheduling-agent database backup

[Timer]
# 03:30 in Israel; Persistent runs a missed backup when the server comes back.
OnCalendar=*-*-* 01:30:00 UTC
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
UNIT
# 6. A cold start in steps (reboot or spot replacement). On one core, the ~45 pods that
#    come back at once starve each other, health checks time out, and Kubernetes restarts
#    them in a loop that never settles (seen 19.11: 100% CPU for 20 minutes). Started once
#    the application runs, the monitoring tools take two minutes and no restarts. So: hold
#    the monitoring tools and Argo CD until the application is up, then let Argo CD bring
#    them back as they are in git.
cat > /usr/local/bin/sa-boot-stagger <<'SCRIPT'
#!/bin/bash
# k3s can restart once more while it settles (seen 19.11: the API refused connections right
# after the hold, and Argo CD was left stopped). So every step retries, and Argo CD is
# brought back on any exit, even a failed one: without it nothing restores the rest.
set -uo pipefail
k() { /usr/local/bin/k3s kubectl --request-timeout=20s "$@"; }
retry() { for _ in $(seq 60); do "$@" && return 0; sleep 5; done; return 1; }
release() {
  retry k -n argocd scale statefulset argocd-application-controller --replicas=1 >/dev/null
  echo "Argo CD controller: $(k -n argocd get statefulset argocd-application-controller -o jsonpath='{.spec.replicas}')"
}
retry k get --raw /readyz >/dev/null
trap release EXIT
retry k -n argocd scale statefulset argocd-application-controller --replicas=0
retry k -n observability scale deploy,statefulset --all --replicas=0
echo "monitoring held; waiting for the application"
for _ in $(seq 60); do
  k -n scheduling-agent wait --for=condition=Available deploy --all --timeout=10s >/dev/null 2>&1 && break
  sleep 5
done
echo "application up (or 10 minutes passed); Argo CD restores the rest from git"
SCRIPT
chmod 0700 /usr/local/bin/sa-boot-stagger
cat > /etc/systemd/system/sa-boot-stagger.service <<'UNIT'
[Unit]
Description=Start the scheduling agent before its monitoring after a cold boot
After=k3s.service
Wants=k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sa-boot-stagger
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable sa-backup.timer sa-boot-stagger.service
systemctl start sa-backup.timer
# A new server (spot replacement) is a cold start too: run it now, without waiting here.
systemctl start --no-block sa-boot-stagger.service

# 7. Security updates, every day, unattended (step 6.6). Amazon Linux 2023 pins its
#    repositories to the release the image was built from, and fixes land in newer releases,
#    so "latest" first; otherwise dnf-automatic finds almost nothing to install.
echo latest > /etc/dnf/vars/releasever
dnf install -y -q dnf-automatic
cat > /etc/dnf/automatic.conf <<'CONF'
[commands]
upgrade_type = security
download_updates = yes
apply_updates = yes
random_sleep = 3600

[emitters]
emit_via = stdio
CONF
systemctl enable --now dnf-automatic.timer

# A kernel or core-library fix takes effect only after a reboot: once a week, and only if
# an installed update needs one (Sunday 04:00 Israel; the staged start above handles it).
cat > /etc/systemd/system/sa-reboot-if-needed.service <<'UNIT'
[Unit]
Description=Reboot if a security update needs it

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'dnf needs-restarting -r >/dev/null || systemctl reboot'
UNIT
cat > /etc/systemd/system/sa-reboot-if-needed.timer <<'UNIT'
[Unit]
Description=Weekly reboot window for security updates

[Timer]
OnCalendar=Sun *-*-* 02:00:00 UTC

[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now sa-reboot-if-needed.timer
echo "boot done: instance=$instance_id"
